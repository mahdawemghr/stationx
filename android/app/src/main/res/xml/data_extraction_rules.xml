<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (API 31+): exclude EVERYTHING from cloud backup and device-to-device transfer.
     The local database and the cloud-sync session must never leave the device via Android backup. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
